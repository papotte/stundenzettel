# Copy this file to .env.local (development) or .env.test (e2e tests) and fill in the values.
# See README.md for setup instructions.

# App Version
NEXT_PUBLIC_APP_VERSION=latest

# Environment: 'development' or 'test' connect to Firebase emulators, 'production' uses real Firebase
NEXT_PUBLIC_ENVIRONMENT=development

# Emulator endpoints (prefixed ports, see firebase.json). Only needed for development/test.
NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=localhost:18080
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:19099
# Used by scripts/ helpers only (e.g. test-webhook-flow.js)
FUNCTIONS_EMULATOR_HOST=localhost:19001

# Firebase Configuration: copy these from your Firebase project settings
NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id
# Firestore database ID. 'test-database' for e2e, 'timewise' matches firebase.json for dev/prod
NEXT_PUBLIC_FIREBASE_DATABASE_ID=timewise

# Stripe: use test keys (pk_test_/sk_test_) for development and emulators
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from the Stripe Dashboard, see docs/PAYMENT_SETUP.md
NEXT_PUBLIC_STRIPE_INDIVIDUAL_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_INDIVIDUAL_YEARLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
NEXT_PUBLIC_STRIPE_TEAM_YEARLY_PRICE_ID=price_...
# Set to 'false' to disable free trials globally
NEXT_PUBLIC_STRIPE_TRIAL_ENABLED=true

# Google Maps: API key with "Geocoding API" enabled
# https://console.cloud.google.com/google/maps-apis/
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Resend (transactional email)
RESEND_API_KEY=re_...
# Public app URL used in email links
NEXT_PUBLIC_APP_URL=http://localhost:9002

# Termly consent banner (optional)
NEXT_PUBLIC_TERMLY_WEBSITE_UUID=

# Web push notifications: generate with `npx web-push generate-vapid-keys`
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
